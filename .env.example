# 本文件只放示例，不要提交真实密码、token 或证书私钥。

# 本地兼容模式（默认）：DOCX_MCP_AUTH=token
# 公网 MCP 使用 OAuth：
DOCX_MCP_AUTH=oauth
DOCX_MCP_PUBLIC_URL=https://mcp.example.com/mcp
DOCX_MCP_OAUTH_PASSWORD=replace-with-a-long-random-owner-password
DOCX_MCP_HOST=127.0.0.1
DOCX_MCP_PORT=8765

# 通过本机反向代理部署时，信任一跳代理以获得正确客户端 IP（用于 OAuth 限流）。
DOCX_MCP_TRUST_PROXY=1

# 可选：不用反向代理，直接由 Node 终止 TLS。
# DOCX_MCP_HOST=0.0.0.0
# DOCX_MCP_TLS_CERT=/absolute/path/to/fullchain.pem
# DOCX_MCP_TLS_KEY=/absolute/path/to/privkey.pem

# 可选持久化位置：
# DOCX_MCP_OAUTH_DB=/var/lib/inkpaw/oauth.db
# DOCX_MCP_USERS=/var/lib/inkpaw/users
