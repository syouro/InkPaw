{
  "name": "plain",
  "description": "裸样式：无页眉无页码无封面页，渲染层默认字体样式，自动编号保留（meta.autoNumber:false 可关）。",
  "autoNumber": true,
  "headingNumbering": {
    "reference": "heading-num",
    "levels": [
      {
        "level": 0,
        "format": "decimal",
        "text": "%1",
        "alignment": "left",
        "suffix": "space",
        "style": {
          "paragraph": {
            "indent": {
              "left": 0,
              "hanging": 0
            }
          }
        }
      },
      {
        "level": 1,
        "format": "decimal",
        "text": "%1.%2",
        "alignment": "left",
        "suffix": "space",
        "style": {
          "paragraph": {
            "indent": {
              "left": 0,
              "hanging": 0
            }
          }
        }
      },
      {
        "level": 2,
        "format": "decimal",
        "text": "%1.%2.%3",
        "alignment": "left",
        "suffix": "space",
        "style": {
          "paragraph": {
            "indent": {
              "left": 0,
              "hanging": 0
            }
          }
        }
      },
      {
        "level": 3,
        "format": "decimal",
        "text": "%1.%2.%3.%4",
        "alignment": "left",
        "suffix": "space",
        "style": {
          "paragraph": {
            "indent": {
              "left": 0,
              "hanging": 0
            }
          }
        }
      },
      {
        "level": 4,
        "format": "decimal",
        "text": "%1.%2.%3.%4.%5",
        "alignment": "left",
        "suffix": "space",
        "style": {
          "paragraph": {
            "indent": {
              "left": 0,
              "hanging": 0
            }
          }
        }
      },
      {
        "level": 5,
        "format": "decimal",
        "text": "%1.%2.%3.%4.%5.%6",
        "alignment": "left",
        "suffix": "space",
        "style": {
          "paragraph": {
            "indent": {
              "left": 0,
              "hanging": 0
            }
          }
        }
      }
    ]
  },
  "meta": {
    "headerText": "",
    "pageNumber": false,
    "titlePage": false,
    "styles": {
      "paragraphStyles": [
        {
          "id": "mdList",
          "basedOn": "Normal",
          "next": "Normal",
          "run": {
            "size": 24
          },
          "paragraph": {
            "spacing": {
              "line": 360,
              "after": 0
            }
          }
        },
        {
          "id": "mdCode",
          "basedOn": "Normal",
          "next": "Normal",
          "run": {
            "font": "Courier New",
            "size": 18
          },
          "paragraph": {
            "spacing": {
              "line": 240,
              "after": 0
            },
            "indent": {
              "left": 360
            }
          }
        },
        {
          "id": "mdQuote",
          "basedOn": "Normal",
          "next": "Normal",
          "run": {
            "italics": true,
            "color": "595959",
            "size": 24
          },
          "paragraph": {
            "spacing": {
              "line": 360,
              "after": 0
            },
            "indent": {
              "left": 720
            }
          }
        },
        {
          "id": "mdTableCell",
          "basedOn": "Normal",
          "next": "Normal",
          "run": {
            "size": 21
          },
          "paragraph": {
            "spacing": {
              "line": 276,
              "after": 0
            }
          }
        },
        {
          "id": "tocTitle",
          "basedOn": "Normal",
          "next": "Normal",
          "run": {
            "size": 30,
            "bold": true,
            "color": "000000"
          },
          "paragraph": {
            "alignment": "center",
            "spacing": {
              "before": 240,
              "after": 240
            }
          }
        },
        {
          "id": "toc1",
          "basedOn": "Normal",
          "next": "Normal",
          "run": {
            "size": 24,
            "color": "000000"
          },
          "paragraph": {
            "spacing": {
              "line": 360,
              "after": 0
            }
          }
        },
        {
          "id": "toc2",
          "basedOn": "Normal",
          "next": "Normal",
          "run": {
            "size": 24,
            "color": "000000"
          },
          "paragraph": {
            "spacing": {
              "line": 360,
              "after": 0
            },
            "indent": {
              "left": 420
            }
          }
        },
        {
          "id": "toc3",
          "basedOn": "Normal",
          "next": "Normal",
          "run": {
            "size": 24,
            "color": "000000"
          },
          "paragraph": {
            "spacing": {
              "line": 360,
              "after": 0
            },
            "indent": {
              "left": 840
            }
          }
        },
        {
          "id": "checklistItem",
          "basedOn": "Normal",
          "next": "Normal",
          "run": {
            "size": 24
          },
          "paragraph": {
            "spacing": {
              "line": 360,
              "after": 0
            }
          }
        }
      ],
      "characterStyles": [
        {
          "id": "mdCodeChar",
          "run": {
            "font": "Courier New",
            "size": 21
          }
        },
        {
          "id": "tocEntry",
          "run": {
            "color": "000000"
          }
        }
      ]
    },
    "numbering": {
      "config": [
        {
          "reference": "md-ordered",
          "levels": [
            {
              "level": 0,
              "format": "decimal",
              "text": "%1.",
              "alignment": "left",
              "style": {
                "paragraph": {
                  "indent": {
                    "left": 720,
                    "hanging": 360
                  }
                }
              }
            },
            {
              "level": 1,
              "format": "decimal",
              "text": "(%2)",
              "alignment": "left",
              "style": {
                "paragraph": {
                  "indent": {
                    "left": 1440,
                    "hanging": 360
                  }
                }
              }
            },
            {
              "level": 2,
              "format": "decimal",
              "text": "%3)",
              "alignment": "left",
              "style": {
                "paragraph": {
                  "indent": {
                    "left": 2160,
                    "hanging": 360
                  }
                }
              }
            }
          ]
        },
        {
          "reference": "md-bullet",
          "levels": [
            {
              "level": 0,
              "format": "bullet",
              "text": "•",
              "alignment": "left",
              "style": {
                "paragraph": {
                  "indent": {
                    "left": 720,
                    "hanging": 360
                  }
                }
              }
            },
            {
              "level": 1,
              "format": "bullet",
              "text": "◦",
              "alignment": "left",
              "style": {
                "paragraph": {
                  "indent": {
                    "left": 1440,
                    "hanging": 360
                  }
                }
              }
            },
            {
              "level": 2,
              "format": "bullet",
              "text": "▪",
              "alignment": "left",
              "style": {
                "paragraph": {
                  "indent": {
                    "left": 2160,
                    "hanging": 360
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "tableStyle": {
      "headerTextOptions": {
        "bold": true
      },
      "headerParagraphOptions": {
        "alignment": "center"
      }
    }
  },
  "captionStyle": {
    "paragraphOptions": {
      "alignment": "center"
    }
  },
  "markdown": {
    "imageMaxWidth": 480
  }
}